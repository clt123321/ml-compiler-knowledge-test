{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "ML Compiler Knowledge Test — Question",
  "type": "object",
  "required": [
    "id",
    "type",
    "module",
    "subtopic",
    "learningObjective",
    "archetype",
    "difficulty",
    "depth",
    "hardwareContext",
    "softwareContext",
    "stem",
    "options",
    "correctAnswers",
    "explanation",
    "optionExplanations",
    "sourceRefs",
    "performanceClaim",
    "reviewStatus",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-N]-[A-Z0-9_]+-[0-9]{3}$"
    },
    "type": { "enum": ["single", "multiple"] },
    "module": {
      "enum": [
        "arch_perf_model",
        "compiler_basics",
        "graph_tensor_ir",
        "pytorch_compiler",
        "mlir_tvm_xla",
        "cuda_triton_kernel",
        "graph_opt_schedule",
        "quantization",
        "core_ops_attention",
        "llm_inference",
        "runtime_deploy",
        "profiling_debug",
        "distributed",
        "paper_design"
      ]
    },
    "subtopic": { "type": "string", "minLength": 3 },
    "learningObjective": { "type": "string", "minLength": 10 },
    "archetype": {
      "enum": [
        "precise_definition",
        "concept_boundary",
        "formula_performance",
        "ir_transformation",
        "code_implementation",
        "performance_diagnosis",
        "systems_dataflow",
        "paper_design_intent"
      ]
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "depth": {
      "enum": ["textbook", "implementation", "systems", "research"]
    },
    "hardwareContext": {
      "type": "object",
      "required": ["vendor", "architecture", "device", "requiredFeatures"],
      "properties": {
        "vendor": {
          "enum": ["NVIDIA", "AMD", "Intel", "Apple", "generic"]
        },
        "architecture": { "type": "string" },
        "device": { "enum": ["GPU", "CPU", "TPU", "NPU", "generic"] },
        "requiredFeatures": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "softwareContext": {
      "type": "object",
      "properties": {
        "framework": { "type": "string" },
        "frameworkVersionScope": { "type": "string" },
        "compiler": { "type": "string" },
        "compilerVersionScope": { "type": "string" },
        "runtime": { "type": "string" },
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "stability": {
          "enum": ["stable_principle", "version_sensitive", "experimental"]
        }
      }
    },
    "tensorContext": {
      "type": ["object", "null"],
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "integer" },
                { "type": "string" }
              ]
            }
          }
        },
        "dtypes": { "type": "array", "items": { "type": "string" } },
        "layouts": { "type": "array", "items": { "type": "string" } },
        "strides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "stem": { "type": "string", "minLength": 10 },
    "codeSnippet": { "type": ["string", "null"] },
    "irSnippet": { "type": ["string", "null"] },
    "profileData": { "type": ["string", "null"] },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "enum": ["A", "B", "C", "D", "E", "F"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "correctAnswers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["A", "B", "C", "D", "E", "F"] }
    },
    "explanation": { "type": "string", "minLength": 20 },
    "optionExplanations": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonImplications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "misconceptionTags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "distractorRationales": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string" },
          "locator": { "type": "string" },
          "supports": {
            "type": "array",
            "items": { "enum": ["A", "B", "C", "D", "E", "F"] }
          }
        }
      }
    },
    "performanceClaim": {
      "type": "object",
      "required": ["present", "evidenceType", "hardwareDependent"],
      "properties": {
        "present": { "type": "boolean" },
        "scope": { "type": "string" },
        "evidenceType": {
          "enum": ["none", "analytical", "measured", "paper_result"]
        },
        "hardwareDependent": { "type": "boolean" }
      }
    },
    "contentCardRef": {
      "type": "string",
      "description": "Path to the content card JSON (data/content-cards/<M>/<id>.json)"
    },
    "reviewStatus": {
      "enum": ["draft", "agent_reviewed", "human_reviewed", "deprecated"]
    },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false
}
