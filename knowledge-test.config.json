    { "code": "D", "name": "pytorch_compiler", "label": "PyTorch Compiler 与动态图捕获", "expected": 35 },
    { "code": "E", "name": "mlir_tvm_xla", "label": "MLIR / TVM / XLA 与编译器生态", "expected": 30 },
    { "code": "F", "name": "cuda_triton_kernel", "label": "CUDA / Triton / GPU Kernel", "expected": 40 },
    { "code": "G", "name": "graph_opt_schedule", "label": "图优化 / 循环变换 / 调度 / 自动调优", "expected": 30 },
    { "code": "H", "name": "quantization", "label": "数值表示、混合精度与模型量化", "expected": 35 },
    { "code": "I", "name": "core_ops_attention", "label": "核心算子、融合 Kernel 与 Attention", "expected": 30 },
    { "code": "J", "name": "llm_inference", "label": "LLM 推理优化与生成系统", "expected": 30 },
    { "code": "K", "name": "runtime_deploy", "label": "Runtime、模型交换与部署", "expected": 30 },
    { "code": "L", "name": "profiling_debug", "label": "Profiling / Benchmark / Debug / 正确性", "expected": 30 },
    { "code": "M", "name": "distributed", "label": "分布式、通信编译与异构执行", "expected": 15 },
    { "code": "N", "name": "paper_design", "label": "论文设计、系统权衡与研究判断", "expected": 10 }
