{
  "schemaVersion": "1.0.0",
  "site": {
    "id": "ml-compiler-knowledge-test",
    "title": "机器学习编译与推理优化知识题库",
    "description": "从编译器基础到 CUDA、Triton、量化与 LLM 推理系统的系统化知识测试。",
    "language": "zh-CN",
    "repository": "clt123321/ml-compiler-knowledge-test",
